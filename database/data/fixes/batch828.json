        "birthdate": "1952-12-10 00:00:00",
        "death_date": "2025-01-09 00:00:00",
        "age": 72,
        "ideologies": "[\"Anti-War\",\"Catholic Worker Movement\",\"Anti-Nuclear\"]",
        "era": "2010s",
        "affiliation": "[\"Voices in the Wilderness\",\"Voices for Creative Nonviolence\",\"Ban Killer Drones\"]",
        "in_custody": 0,
