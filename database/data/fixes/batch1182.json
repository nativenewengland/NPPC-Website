    {
      "table": "prisoners",
      "name": "Hudson Austin",
      "slug": "hudson-austin",
      "expected": {
        "id": "d55d9821-8675-4481-951e-a70366f9fafe",
        "name": "Hudson Austin",
        "sort_order": 30709,
        "photo": "prisoners/hudson-austin-trim20261017.png",
        "description": "Hudson Austin was a Grenadian government or military figure imprisoned in the Grenada Seventeen case following the 1983 U.S. invasion. Amnesty International documents nine to twelve days of incommunicado U.S. military custody before transfer to Grenadian authorities. The group was later convicted in connection with the killings of Maurice Bishop and others. Amnesty classified them as political prisoners and challenged the fairness of their trial without taking a position on guilt or innocence. Associated Press reports actual release from Richmond Hill Prison on December 18, 2008.",
        "years_in_prison": null,
        "state": null,
